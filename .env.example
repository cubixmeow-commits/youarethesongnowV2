# Application
APP_ENV=development
APP_DEBUG=true
APP_URL=http://127.0.0.1:8080
APP_KEY=replace-with-a-random-local-secret
APP_TIMEZONE=UTC

# Private local data paths. Production paths must live outside the public directory.
DATABASE_PATH=var/data/yatsn.sqlite
PRIVATE_STORAGE_PATH=var/storage
LOG_PATH=var/log

# Development safeguards
ALLOW_EXTERNAL_USERS=false
ALLOW_PUBLIC_REGISTRATION=false
ALLOW_LIVE_PAYMENTS=false
ALLOW_PROTECTED_LYRICS_COMMERCIAL_USE=false
DEVELOPMENT_GEMINI_LYRICS_SEARCH=false
AI_PROVIDERS_ENABLED=false
MONTHLY_AI_BUDGET_CENTS=10000

# Configurable development values until benchmarks are complete
DEVELOPMENT_MONTHLY_CREDITS=100
LOW_QUALITY_CREDITS=1
MEDIUM_QUALITY_CREDITS=2
HIGH_QUALITY_CREDITS=3

# Stripe test mode only
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Transactional email
MAIL_TRANSPORT=log
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=support@youarethesongnow.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=support@youarethesongnow.com
MAIL_FROM_NAME=You Are The Song Now

# AI provider adapters. Keep real values only in .env or protected hosting configuration.
# Gemini text (Song DNA): use GEMINI_MODEL + GEMINI_LIVE_CALLS. Private, nonconfidential material only on Free tier.
# Gemini image (portrait artwork): use GEMINI_IMAGE_MODEL + GEMINI_IMAGE_LIVE_CALLS. Sends portraits server-side only.
# fal and Replicate remain optional experimental image providers for later benchmarking.
GROQ_API_KEY=
GEMINI_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=
CREATIVE_PROVIDER=auto
# Image preference: auto (Gemini image when live), gemini, fal, or replicate.
IMAGE_PROVIDER=auto
GEMINI_MODEL=gemini-3.6-flash
# Optional Explore override. Leave empty to reuse GEMINI_MODEL (recommended).
# Avoid gemini-2.5-flash-lite unless your API key already has prior 2.5 access; many keys get HTTP 404.
GEMINI_EXPLORE_MODEL=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Development default: 1K. Supported values include 512, 1K, 2K, 4K.
GEMINI_IMAGE_SIZE=1K
GROQ_MODEL=openai/gpt-oss-20b
FAL_IMAGE_MODEL=fal-ai/flux-pro/kontext/multi
REPLICATE_IMAGE_MODEL=prunaai/p-image-edit
GROQ_LIVE_CALLS=false
GEMINI_LIVE_CALLS=false
GEMINI_IMAGE_LIVE_CALLS=false
FAL_LIVE_CALLS=false
REPLICATE_LIVE_CALLS=false
AI_ALLOW_DETERMINISTIC_FALLBACK=false
AI_TEXT_TIMEOUT_SECONDS=45
AI_IMAGE_TIMEOUT_SECONDS=85
AI_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=30
# Conservative accounting estimates; update after checking provider billing.
GEMINI_TEXT_COST_CENTS=0
GEMINI_IMAGE_COST_CENTS=7
GROQ_TEXT_COST_CENTS=1
FAL_IMAGE_COST_CENTS=4
# P-Image-Edit currently costs $0.01 per portrait-integrated output.
REPLICATE_IMAGE_COST_CENTS=1

# Local owner seed (required for php bin/console.php seed-owner). Keep out of Git.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_DISPLAY_NAME=Owner
