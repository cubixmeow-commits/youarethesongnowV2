Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Resolve fingerprinted asset URLs to their real files.
    RewriteRule ^assets/r/[a-f0-9]{12}/(css|js)/(.+)$ assets/$1/$2 [L]

    # Serve existing files and directories normally.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route application URLs through the PHP front controller.
    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#^/assets/r/[a-f0-9]{12}/(?:css|js)/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>
